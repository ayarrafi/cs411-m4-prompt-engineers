# Copy to .env and fill in locally. Never paste the real key into chat or HTML.
TUTOR_PROVIDER=groq
GROQ_API_KEY=
# Pilot model; verify availability in your Groq account before the study.
TUTOR_MODEL=qwen/qwen3.8-27b
TUTOR_REASONING_EFFORT=none
APP_ORIGIN=http://127.0.0.1:8080
# Generate with: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
STUDY_AI_TOKENS=
# Centralized submission storage (Firebase Storage: stored as <condition>/<participantId>.json)
# Bucket name from Firebase Console -> Storage (e.g. your-project.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=
# Provide EITHER the path to your Firebase service account JSON file (recommended for Render Secret Files or local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=
# OR paste the service account JSON string (or base64-encoded JSON) directly as a secret env var
FIREBASE_SERVICE_ACCOUNT_JSON=
PORT=8080
HOST=127.0.0.1
